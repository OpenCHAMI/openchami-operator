# Goreleaser pre-builds the operator and probe binaries for each target
# platform and copies them into the build context under $TARGETPLATFORM/ before
# invoking docker buildx.
# The development Dockerfile (./Dockerfile) retains the multi-stage build for
# use with `make docker-build`.
FROM gcr.io/distroless/static:nonroot
WORKDIR /
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/manager .
COPY ${TARGETPLATFORM}/probe .
USER 65532:65532
ENTRYPOINT ["/manager"]
